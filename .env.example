# mcp-youtube — environment configuration
# Copy to `.env` and fill in real values; .env is gitignored.

# ---- Anti-ban / rate limiting ---------------------------------------------
# Random sleep window between calls to fetch_transcript. Keep these
# conservative — YouTube will ban your residential IP if you hammer it.
RATE_LIMIT_MIN_SECONDS=5
RATE_LIMIT_MAX_SECONDS=10

# ---- Default fetch behaviour ----------------------------------------------
DEFAULT_LANGUAGE=en
FALLBACK_LANGUAGES=en-US,en-GB

# ---- Webshare proxy (RESERVED — NOT wired in yet) -------------------------
# Set both to enable rotating residential proxies via youtube-transcript-api.
# These are read at startup but the proxy is not yet plumbed; the code logs a
# warning so you know fetches are still going through your direct IP.
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=

# ---- Server settings ------------------------------------------------------
# You only need any of this for the Docker / HTTP deployment. Running locally
# over stdio needs no .env at all — the defaults are the right ones.
#
# stdio = the MCP client spawns this process and talks over stdin/stdout.
# http  = long-lived Streamable HTTP server on MCP_HOST:MCP_PORT at /mcp.
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=3716
LOG_LEVEL=INFO
LOG_FORMAT=json
